{
  "name": "ai-marketing-manager-provider-spike-harness",
  "version": "0.0.0",
  "private": true,
  "description": "Internal Phase 1 provider behavior spike harness for AI Marketing Manager.",
  "type": "module",
  "scripts": {
    "test": "vitest run --reporter=verbose",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "p1-t02": "npm run build --silent && node dist/provider-spike/p1-t02-runner.js",
    "p1-t02-f01": "npm run build --silent && node dist/provider-spike/p1-t02-f01-runner.js",
    "p1-t03": "npm run build --silent && node dist/provider-spike/p1-t03-runner.js",
    "p1-t04": "npm run build --silent && node dist/provider-spike/p1-t04-runner.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
